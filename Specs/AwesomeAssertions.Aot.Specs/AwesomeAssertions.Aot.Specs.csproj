<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AwesomeAssertions.Aot.Specs</RootNamespace>
    <AssemblyName>AwesomeAssertions.Aot.Specs</AssemblyName>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\Src\AwesomeAssertions.snk</AssemblyOriginatorKeyFile>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn),IDE0052,1573,1591,1712,CS8002,CS7022</NoWarn>
    <DebugType>embedded</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Src\AwesomeAssertions\AwesomeAssertions.csproj" />
    <ProjectReference Include="..\..\Tests\AssemblyA\AssemblyA.csproj" />
    <ProjectReference Include="..\..\Tests\AssemblyB\AssemblyB.csproj" />
    <ProjectReference Include="..\..\Tests\ExampleExtensions\ExampleExtensions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Microsoft.Testing.Platform" Version="1.0.0-preview.23621.14" />
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
  </ItemGroup>

  <!-- Link test source files from AwesomeAssertions.Specs -->
  <ItemGroup>
    <!-- Include core test directories that work in AOT -->
    <Compile Include="../../Tests/AwesomeAssertions.Specs/AndWhichConstraintSpecs.cs" />
    <Compile Include="../../Tests/AwesomeAssertions.Specs/AssertionExtensionsSpecs.cs" />
    <Compile Include="../../Tests/AwesomeAssertions.Specs/Common/**/*.cs" />
    <Compile Include="../../Tests/AwesomeAssertions.Specs/Collections/**/*.cs" />
    <!-- Exclude problematic test files -->
    <Compile Remove="../../Tests/AwesomeAssertions.Specs/Common/CallerIdentifierSpecs.cs" />
    <Compile Remove="../../Tests/AwesomeAssertions.Specs/Collections/**/UIFactsDefinition.cs" />
  </ItemGroup>

  <!-- Exclude Program.cs from linked files, we have our own -->
  <ItemGroup>
    <Compile Remove="../../Tests/AwesomeAssertions.Specs/Program.cs" />
  </ItemGroup>

</Project>
