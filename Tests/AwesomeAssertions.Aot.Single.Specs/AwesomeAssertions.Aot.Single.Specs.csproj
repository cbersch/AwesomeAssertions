<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AwesomeAssertions.Aot.Single.Specs</RootNamespace>
    <AssemblyName>AwesomeAssertions.Aot.Single.Specs</AssemblyName>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\Src\AwesomeAssertions.snk</AssemblyOriginatorKeyFile>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <DefineConstants>$(DefineConstants);AWESOME_ASSERTIONS_AOT</DefineConstants>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn),IDE0052,1573,1591,1712,CS8002</NoWarn>
    <DebugType>embedded</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Src\AwesomeAssertions\AwesomeAssertions.csproj" />
    <ProjectReference Include="..\..\Tests\AssemblyA\AssemblyA.csproj" />
    <ProjectReference Include="..\..\Tests\AssemblyB\AssemblyB.csproj" />
    <ProjectReference Include="..\..\Tests\ExampleExtensions\ExampleExtensions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.aot.mtp-v2" Version="4.0.0-pre.154" />
    <PackageReference Include="Microsoft.Testing.Platform" Version="2.3.3" />
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
  </ItemGroup>

  <!-- Link test source files from AwesomeAssertions.Specs -->
  <ItemGroup>
    <Compile Include="../AwesomeAssertions.Specs/Numeric/*.cs" LinkBase="Numeric" />

    <Compile Include="../../Tests/AwesomeAssertions.Specs/AndWhichConstraintSpecs.cs" />
    <Compile Include="../../Tests/AwesomeAssertions.Specs/AssertionExtensions.cs" />
    <Compile Include="../../Tests/AwesomeAssertions.Specs/FakeClock.cs" />
    <Compile Include="../../Tests/AwesomeAssertions.Specs/RandomDataExtensions.cs" />
    <Compile Include="../../Tests/AwesomeAssertions.Specs/TestTimer.cs" />
    <Compile Include="../../Tests/AwesomeAssertions.Specs/Common/**/*.cs" LinkBase="Common" />
  </ItemGroup>

</Project>
