<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AwesomeAssertions.Aot.Specs</RootNamespace>
    <AssemblyName>AwesomeAssertions.Aot.Specs</AssemblyName>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\Src\AwesomeAssertions.snk</AssemblyOriginatorKeyFile>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn),IDE0052,1573,1591,1712,CS8002</NoWarn>
    <DebugType>embedded</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Src\AwesomeAssertions\AwesomeAssertions.csproj" />
    <ProjectReference Include="..\..\Tests\AssemblyA\AssemblyA.csproj" />
    <ProjectReference Include="..\..\Tests\AssemblyB\AssemblyB.csproj" />
    <ProjectReference Include="..\..\Tests\ExampleExtensions\ExampleExtensions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.aot.mtp-v2" Version="4.0.0-pre.154" />
    <PackageReference Include="Microsoft.Testing.Platform" Version="2.3.3" />
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
  </ItemGroup>

  <!-- Link test source files from AwesomeAssertions.Specs -->
  <ItemGroup>
    <!-- Include core test directories that work in AOT -->
    <Compile Include="../../Tests/AwesomeAssertions.Specs/AndWhichConstraintSpecs.cs" />
    <Compile Include="../../Tests/AwesomeAssertions.Specs/AssertionExtensions.cs" />
    <Compile Include="../../Tests/AwesomeAssertions.Specs/FakeClock.cs" />
    <Compile Include="../../Tests/AwesomeAssertions.Specs/RandomDataExtensions.cs" />
    <Compile Include="../../Tests/AwesomeAssertions.Specs/TestTimer.cs" />
    <Compile Include="../../Tests/AwesomeAssertions.Specs/Common/**/*.cs" LinkBase="Common" />
    <Compile Include="../../Tests/AwesomeAssertions.Specs/Collections/**/*.cs" LinkBase="Collections" />
    <Compile Include="../../Tests/AwesomeAssertions.Specs/Primitives/**/*.cs" LinkBase="Primitives" />
    <Compile Include="../../Tests/AwesomeAssertions.Specs/Numeric/**/*.cs" LinkBase="Numeric" />
    <Compile Include="../../Tests/AwesomeAssertions.Specs/Xml/**/*.cs" LinkBase="Xml" />
    <Compile Include="../../Tests/AwesomeAssertions.Specs/Exceptions/**/*.cs" LinkBase="Exceptions" />
    <Compile Include="../../Tests/AwesomeAssertions.Specs/Extensions/**/*.cs" LinkBase="Extensions" />
    <Compile Include="../../Tests/AwesomeAssertions.Specs/Streams/**/*.cs" LinkBase="Streams" />
    <Compile Include="../../Tests/AwesomeAssertions.Specs/Configuration/**/*.cs" LinkBase="Configuration" />
    <Compile Include="../../Tests/AwesomeAssertions.Specs/Execution/**/*.cs" LinkBase="Execution" />
    <Compile Include="../../Tests/AwesomeAssertions.Specs/Formatting/**/*.cs" LinkBase="Formatting" />
    <!-- Exclude problematic test files -->
    <Compile Remove="../../Tests/AwesomeAssertions.Specs/Common/CallerIdentifierSpecs.cs" />
    <Compile Remove="../../Tests/AwesomeAssertions.Specs/Common/TypeExtensionsSpecs.cs" />
    <Compile Remove="../../Tests/AwesomeAssertions.Specs/Collections/**/UIFactsDefinition.cs" />
    <Compile Remove="../../Tests/AwesomeAssertions.Specs/Execution/CallerIdentificationSpecs.cs" />
    <Compile Remove="../../Tests/AwesomeAssertions.Specs/Formatting/FormatterSpecs.cs" />
    <Compile Remove="../../Tests/AwesomeAssertions.Specs/Exceptions/AsyncFunctionExceptionAssertionSpecs.cs" />
    <Compile Remove="../../Tests/AwesomeAssertions.Specs/Primitives/StringComparisonSpecs.cs" />
    <Compile Remove="../../Tests/AwesomeAssertions.Specs/Xml/XDocumentAssertionSpecs.cs" />
    <Compile Remove="../../Tests/AwesomeAssertions.Specs/Xml/XElementAssertionSpecs.cs" />
    <Compile Remove="../../Tests/AwesomeAssertions.Specs/Xml/XmlNodeAssertionSpecs.cs" />
    <Compile Remove="../../Tests/AwesomeAssertions.Specs/Numeric/ComparableSpecs.cs" />
    <Compile Remove="../../Tests/AwesomeAssertions.Specs/Collections/CollectionAssertionSpecs.AllSatisfy.cs" />
    <Compile Remove="../../Tests/AwesomeAssertions.Specs/Collections/CollectionAssertionSpecs.ContainEquivalentOf.cs" />
    <Compile Remove="../../Tests/AwesomeAssertions.Specs/Configuration/EquivalencyOptionsSpecs.cs" />
    <Compile Remove="../../Tests/AwesomeAssertions.Specs/Configuration/GlobalConfigurationSpecs.cs" />
  </ItemGroup>

</Project>
